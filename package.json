{
  "name": "infraxis",
  "version": "0.2.0",
  "private": true,
  "description": "Infraxis — Universal CI/CD & Software Infrastructure Control Plane",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "worker": "node worker/agent.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate-from-sqlite": "node scripts/migrate-sqlite-to-pg.js",
    "db:truncate": "node scripts/truncate-tables.js",
    "test": "node --test tests/**/*.test.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.13.1",
    "ws": "^8.22.0"
  }
}
