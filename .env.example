# Infraxis Configuration Template (.env.example)
# Generate random 32-byte tokens using: openssl rand -hex 32

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://ci_user:CHANGE_ME@127.0.0.1:5432/infraxis
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DATABASE_SSL=false

# Control Plane & Admin Authentication
CI_ADMIN_TOKEN=9bfbd698c488171a0495476d56f511072c79ffd0e768af86c02678ef776d3801
INFRAXIS_ADMIN_TOKEN=9bfbd698c488171a0495476d56f511072c79ffd0e768af86c02678ef776d3801

# Infraxis Agent (Worker) Authentication
CI_WORKER_TOKEN=91f0465f93dccb050266f320db40820cd19afe680700e48b80327ff606ba2cc8
INFRAXIS_WORKER_TOKEN=91f0465f93dccb050266f320db40820cd19afe680700e48b80327ff606ba2cc8

# Webhook Security
BITBUCKET_WEBHOOK_TOKEN=ccd852aa6938cdc592cbe9f327967c7f4fa580a1574f9565c12343269ce11dff
GITHUB_WEBHOOK_SECRET=b490baf106d7e2acb5963a9911f27f7055bd6424dfeab46a9693d4b9f41c043c

# Server Network & Host
CI_BASE_URL=http://127.0.0.1:8787
INFRAXIS_BASE_URL=http://127.0.0.1:8787
CI_PORT=8787
CI_BIND_HOST=0.0.0.0

# Next.js Development Proxy
CI_BACKEND_URL=http://127.0.0.1:8787

# Storage Paths
CI_DATA_DIR=./data
CI_ARTIFACT_DIR=./artifacts

# Infraxis Agent (Worker) Configuration
CI_WORKER_ID=mac-agent-01
CI_WORKER_LABELS=android,release,ios
CI_WORK_DIR=./work
CI_POLL_MS=5000
CI_AUTO_START_WORKER=true

# Optional Redis Cache / PubSub for Multi-Node Scaling
REDIS_URL=redis://127.0.0.1:6379

# Reverse Proxy Trust (only set true behind trusted reverse proxies like Nginx/Cloudflare)
TRUST_PROXY=false

# iOS Code Signing & Distribution Configuration
IOS_CODE_SIGNING_ALLOWED=true
# Apple Developer 10-character Team ID (e.g. G3WQY6FQ95)
IOS_DEVELOPMENT_TEAM=G3WQY6FQ95
# Signing Identity: "Apple Development", "Apple Distribution", or exact cert name
IOS_CODE_SIGN_IDENTITY=Apple Development
# Export Method: development, ad-hoc, app-store, enterprise
IOS_EXPORT_METHOD=development
# Optional: path to custom ExportOptions.plist
# IOS_EXPORT_OPTIONS_PLIST=./ios/ExportOptions.plist
